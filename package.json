{
  "name": "weighted-sampler",
  "version": "1.1.0",
  "description": "A zero-dependency library for weighted sampling using Walker's alias method.",
  "keywords": [
    "algorithm",
    "choice",
    "random",
    "sampling",
    "weighted"
  ],
  "homepage": "https://github.com/y-i/weighted-sampler#readme",
  "bugs": {
    "url": "https://github.com/y-i/weighted-sampler/issues"
  },
  "license": "MIT",
  "author": "y-i",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/y-i/weighted-sampler.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "benchmark": "npm run build && node benchmark/weighted-sampler.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "tsc",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
